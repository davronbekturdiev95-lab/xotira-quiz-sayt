# ============================================================
# Bu faylning nusxasini oling va nomini ".env" qilib qo'ying
# ============================================================

# Birinchi (bosh) admin — faqat BIRINCHI ishga tushirishda yaratiladi.
# Keyinchalik parol admin panel orqali o'zgartiriladi.
BOSH_ADMIN_LOGIN=admin
ADMIN_PAROL=

# Google Apps Script "Web app URL" (ixtiyoriy)
SHEETS_URL=
SHEETS_SECRET=buni-ozgartiring-uzun-maxfiy-kalit

# Server porti
PORT=3000

# Qaysi manzilda tinglash. Serverda 127.0.0.1 qo'ying — sayt faqat Nginx orqali ochiladi.
# Kompyuterda sinash uchun bo'sh qoldiring.
HOST=

# ============================================================
# amoCRM — lidlar avtomatik tushishi uchun (ixtiyoriy)
# Bo'sh qolsa integratsiya o'chiq bo'ladi.
#
# Token olish: amoCRM -> Sozlamalar -> Integratsiyalar ->
#   "Yangi integratsiya" -> huquqlarni bering ->
#   "Kalitlar va doiralar" -> uzoq muddatli token (long-lived token)
# ============================================================
AMO_DOMEN=
AMO_TOKEN=

# Ixtiyoriy — bo'sh qolsa amoCRM standart voronka/bosqichga qo'yadi
AMO_PIPELINE_ID=
AMO_STATUS_ID=
AMO_RESPONSIBLE_ID=
AMO_TEG=Xotira testi

# ============================================================
# Telegram bot + Mini App (ixtiyoriy)
# Ikkalasi to'ldirilsa bot ishga tushadi va test Telegram ichida ham ochiladi.
# ============================================================
BOT_TOKEN=
SAYT_URL=
