# Birinchi (bosh) admin — faqat BIRINCHI ishga tushirishda yaratiladi.
# Keyinchalik parol admin panel orqali o'zgartiriladi.
BOSH_ADMIN_LOGIN=admin
ADMIN_PAROL=

# Google Apps Script "Web app URL" (ixtiyoriy)
SHEETS_URL=
SHEETS_SECRET=buni-ozgartiring-uzun-maxfiy-kalit

# Server porti
PORT=3000
